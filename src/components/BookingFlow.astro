---
import type { PublicAgent } from '../domain/public-contract.ts';

interface Props { agents: PublicAgent[] }
const { agents } = Astro.props;
---

<section class="booking-flow" aria-labelledby="booking-title" data-booking-flow>
  <header class="booking-intro">
    <div>
      <span class="demo-badge">Demo</span>
      <p class="eyebrow">Request a viewing</p>
      <h2 id="booking-title">Choose a time to explore the booking journey</h2>
    </div>
    <p class="privacy-note">
      A safe, fictional walkthrough: no current availability is claimed and nothing is sent,
      saved or shared over the network.
    </p>
  </header>

  <div class="booking-launcher" data-booking-launcher>
    <div>
      <strong>Four short steps</strong>
      <span>Agent, Jersey date and time, your details, then review.</span>
    </div>
    <button class="button-primary" type="button" data-booking-open>Start booking demo</button>
  </div>

  <div class="booking-panel" data-booking-panel hidden>
    <nav class="step-navigation" aria-label="Booking demo progress">
      <ol>
        <li data-progress-step="agent" aria-current="step"><span>1</span>1. Agent</li>
        <li data-progress-step="date-time"><span>2</span>2. Date and time</li>
        <li data-progress-step="details"><span>3</span>3. Your details</li>
        <li data-progress-step="review"><span>4</span>4. Review</li>
      </ol>
    </nav>

    <form novalidate data-booking-form>
      <section class="booking-step" data-booking-step="agent" aria-labelledby="booking-agent-title">
        <p class="step-kicker">Step 1 of 4 <span>Demo</span></p>
        <h3 id="booking-agent-title" tabindex="-1" data-step-heading>Choose an agent</h3>
        <p class="step-copy">Select one of Hampton's published team members.</p>

        <fieldset class="agent-options" data-agent-options aria-describedby="booking-agent-error">
          <legend class="visually-hidden">Agent</legend>
          {agents.map((agent) => (
            <label class="agent-option">
              <input type="radio" name="agentId" value={agent.public_id} required />
              <span>
                <strong>{agent.name}</strong>
                <small>{agent.role}</small>
              </span>
            </label>
          ))}
        </fieldset>
        <p class="field-error" id="booking-agent-error" data-error-for="agentId" aria-live="polite"></p>

        <div class="form-actions">
          <button class="button-primary" type="button" data-booking-next>Continue</button>
          <button class="button-quiet" type="button" data-booking-cancel>Cancel</button>
        </div>
      </section>

      <section class="booking-step" data-booking-step="date-time" aria-labelledby="booking-date-title" hidden>
        <p class="step-kicker">Step 2 of 4 <span>Demo</span></p>
        <h3 id="booking-date-title" tabindex="-1" data-step-heading>Choose a date and time</h3>
        <p class="step-copy">
          Illustrative weekday slots are shown in Jersey local time. They are not Hampton availability.
        </p>

        <div class="field-grid">
          <div class="field">
            <label for="booking-date">Date</label>
            <select id="booking-date" name="date" required aria-describedby="booking-date-hint booking-date-error">
              <option value="">Choose a date</option>
            </select>
            <p class="field-hint" id="booking-date-hint">Tomorrow through day 30; weekdays only.</p>
            <p class="field-error" id="booking-date-error" data-error-for="date" aria-live="polite"></p>
          </div>
          <div class="field">
            <label for="booking-time">Time <span class="inline-demo">Demo</span></label>
            <select id="booking-time" name="time" required disabled aria-describedby="booking-time-hint booking-time-error">
              <option value="">Choose a time</option>
            </select>
            <p class="field-hint" id="booking-time-hint">Jersey time, 09:00–16:30.</p>
            <p class="field-error" id="booking-time-error" data-error-for="time" aria-live="polite"></p>
          </div>
        </div>

        <div class="form-actions">
          <button class="button-secondary" type="button" data-booking-back>Back</button>
          <button class="button-primary" type="button" data-booking-next>Continue</button>
          <button class="button-quiet" type="button" data-booking-cancel>Cancel</button>
        </div>
      </section>

      <section class="booking-step" data-booking-step="details" aria-labelledby="booking-details-title" hidden>
        <p class="step-kicker">Step 3 of 4 <span>Demo</span></p>
        <h3 id="booking-details-title" tabindex="-1" data-step-heading>Your details</h3>
        <p class="step-copy">Used in page memory only while this demo is open.</p>

        <div class="field-grid">
          <div class="field">
            <label for="booking-name">Name</label>
            <input id="booking-name" name="name" type="text" autocomplete="name" maxlength="100" required aria-describedby="booking-name-error" />
            <p class="field-error" id="booking-name-error" data-error-for="name" aria-live="polite"></p>
          </div>
          <div class="field">
            <label for="booking-email">Email</label>
            <input id="booking-email" name="email" type="email" autocomplete="email" required aria-describedby="booking-email-error" />
            <p class="field-error" id="booking-email-error" data-error-for="email" aria-live="polite"></p>
          </div>
          <div class="field">
            <label for="booking-phone">Phone <span class="optional">Optional</span></label>
            <input id="booking-phone" name="phone" type="tel" autocomplete="tel" minlength="7" maxlength="20" pattern="[0-9 +()\-]+" aria-describedby="booking-phone-error" />
            <p class="field-error" id="booking-phone-error" data-error-for="phone" aria-live="polite"></p>
          </div>
          <div class="field field-wide">
            <label for="booking-note">Note <span class="optional">Optional</span></label>
            <textarea id="booking-note" name="note" rows="4" maxlength="500" aria-describedby="booking-note-hint booking-note-error"></textarea>
            <p class="field-hint" id="booking-note-hint">Up to 500 characters.</p>
            <p class="field-error" id="booking-note-error" data-error-for="note" aria-live="polite"></p>
          </div>
        </div>

        <div class="form-actions">
          <button class="button-secondary" type="button" data-booking-back>Back</button>
          <button class="button-primary" type="button" data-booking-next>Review</button>
          <button class="button-quiet" type="button" data-booking-cancel>Cancel</button>
        </div>
      </section>

      <section class="booking-step" data-booking-step="review" aria-labelledby="booking-review-title" hidden>
        <p class="step-kicker">Step 4 of 4 <span>Demo</span></p>
        <h3 id="booking-review-title" tabindex="-1" data-step-heading>Review your request</h3>
        <p class="step-copy">Confirming clears these values. It does not contact Hampton.</p>

        <dl class="review-list">
          <div><dt>Agent</dt><dd data-review="agentId"></dd></div>
          <div><dt>Date</dt><dd data-review="date"></dd></div>
          <div><dt>Time</dt><dd data-review="time"></dd></div>
          <div><dt>Name</dt><dd data-review="name"></dd></div>
          <div><dt>Email</dt><dd data-review="email"></dd></div>
          <div><dt>Phone</dt><dd data-review="phone"></dd></div>
          <div class="review-wide"><dt>Note</dt><dd data-review="note"></dd></div>
        </dl>

        <div class="form-actions">
          <button class="button-secondary" type="button" data-booking-back>Back</button>
          <button class="button-primary" type="button" data-booking-confirm>Confirm (demo)</button>
          <button class="button-quiet" type="button" data-booking-cancel>Cancel</button>
        </div>
      </section>
    </form>
  </div>

  <div class="confirmation" data-booking-confirmation hidden>
    <span class="demo-badge">Demo</span>
    <h3 tabindex="-1" data-confirmation-heading>Demo - nothing has been sent</h3>
    <p>
      No appointment was made and no personal details were saved. Contact Hampton directly to ask
      about current availability.
    </p>
    <button class="button-primary" type="button" data-booking-restart>Start again</button>
  </div>

  <p class="booking-status" data-booking-status aria-live="polite"></p>
</section>

<script>
  import { initBookingFlows } from './booking-flow.ts';

  initBookingFlows();
</script>

<style>
  .booking-flow {
    overflow: hidden;
    border-top: 1px solid var(--line, #c8c9c5);
    border-bottom: 1px solid var(--line, #c8c9c5);
    background: transparent;
    color: var(--ink, #323644);
  }

  .booking-intro {
    display: grid;
    gap: 1.5rem;
    padding: clamp(1.5rem, 5vw, 3.5rem);
    border-bottom: 1px solid var(--line, #c8c9c5);
    background: transparent;
  }

  .demo-badge,
  .inline-demo,
  .step-kicker span {
    display: inline-flex;
    align-items: center;
    min-height: 1.6rem;
    padding: 0.18rem 0.5rem;
    border: 1px solid var(--brand-deep, #1f4e78);
    color: var(--brand-deep, #1f4e78);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    line-height: 1;
    text-transform: uppercase;
  }

  .eyebrow {
    margin: 1rem 0 0;
    color: var(--brand-deep, #1f4e78);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  h2,
  h3 {
    color: var(--ink, #323644);
    font-family: var(--font-display, Georgia, 'Times New Roman', serif);
    font-weight: 400;
    line-height: 1.08;
    text-wrap: balance;
  }

  h2 {
    max-width: 18ch;
    margin: 0.7rem 0 0;
    font-size: clamp(2rem, 5vw, 3.35rem);
    letter-spacing: -0.035em;
  }

  h3 {
    margin: 0.65rem 0 0;
    font-size: clamp(1.65rem, 4vw, 2.35rem);
    letter-spacing: -0.025em;
  }

  .privacy-note {
    align-self: end;
    max-width: 34rem;
    margin: 0;
    padding-left: 1rem;
    border-left: 3px solid var(--brand-deep, #1f4e78);
    color: var(--ink-2, #5b6170);
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .booking-launcher {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    flex-wrap: wrap;
    padding: clamp(1.25rem, 4vw, 2rem) clamp(1.5rem, 5vw, 3.5rem);
  }

  .booking-launcher div {
    display: grid;
    gap: 0.2rem;
  }

  .booking-launcher span {
    color: var(--ink-2, #5b6170);
    font-size: 0.82rem;
  }

  .step-navigation {
    overflow-x: auto;
    border-bottom: 1px solid var(--line, #c8c9c5);
    background: #f0f2f3;
  }

  .step-navigation ol {
    display: grid;
    grid-template-columns: repeat(4, minmax(8.5rem, 1fr));
    min-width: 36rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .step-navigation li {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 4rem;
    padding: 0.75rem 1rem;
    border-bottom: 3px solid transparent;
    color: var(--ink-2, #5b6170);
    font-size: 0.73rem;
    font-weight: 700;
  }

  .step-navigation li span {
    display: grid;
    width: 1.65rem;
    aspect-ratio: 1;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid currentColor;
    border-radius: 50%;
  }

  .step-navigation li[aria-current='step'] {
    border-bottom-color: var(--brand-deep, #1f4e78);
    background: #fff;
    color: var(--brand-deep, #1f4e78);
  }

  .booking-step,
  .confirmation {
    max-width: 58rem;
    margin-inline: auto;
    padding: clamp(1.75rem, 5vw, 3.5rem);
  }

  .step-kicker {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin: 0;
    color: var(--brand-deep, #1f4e78);
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .step-copy {
    max-width: 62ch;
    margin: 0.9rem 0 0;
    color: var(--ink-2, #5b6170);
  }

  .agent-options {
    display: grid;
    gap: 0.75rem;
    margin: 1.75rem 0 0;
    padding: 0;
    border: 0;
  }

  .agent-option {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 0.9rem;
    min-height: 4.5rem;
    padding: 0.85rem 1rem;
    border: 1px solid var(--ink-2, #5b6170);
    background: #fff;
    cursor: pointer;
  }

  .agent-option:has(input:checked) {
    border: 2px solid var(--brand-deep, #1f4e78);
    background: #eef4f8;
  }

  .agent-option input {
    width: 1.35rem;
    height: 1.35rem;
    margin: 0;
    accent-color: var(--brand-deep, #1f4e78);
  }

  .agent-option span {
    display: grid;
    gap: 0.2rem;
  }

  .agent-option small {
    color: var(--ink-2, #5b6170);
  }

  .field-grid {
    display: grid;
    gap: 1.2rem;
    margin-top: 1.75rem;
  }

  .field {
    min-width: 0;
  }

  .field label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.45rem;
    font-size: 0.82rem;
    font-weight: 800;
  }

  .optional {
    color: var(--ink-2, #5b6170);
    font-size: 0.7rem;
    font-weight: 400;
  }

  input,
  select,
  textarea {
    display: block;
    width: 100%;
    min-width: 0;
    min-height: 3rem;
    padding: 0.72rem 0.8rem;
    border: 1px solid var(--ink-2, #5b6170);
    border-radius: 0;
    background: #fff;
    color: var(--ink, #323644);
    font: inherit;
  }

  select:disabled {
    border-color: var(--line, #c8c9c5);
    background: #f0f2f3;
    color: var(--ink-2, #5b6170);
    cursor: not-allowed;
  }

  textarea {
    resize: vertical;
  }

  [aria-invalid='true'] {
    border: 2px solid #8d2431;
  }

  .field-hint,
  .field-error {
    margin: 0.35rem 0 0;
    font-size: 0.78rem;
  }

  .field-hint {
    color: var(--ink-2, #5b6170);
  }

  .field-error {
    min-height: 1.2rem;
    color: #8d2431;
    font-weight: 700;
  }

  .form-actions {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-wrap: wrap;
    margin-top: 1.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line, #c8c9c5);
  }

  button {
    min-height: 2.75rem;
    padding: 0.65rem 1.1rem;
    border-radius: 0;
    font: inherit;
    font-size: 0.82rem;
    font-weight: 800;
    cursor: pointer;
    transition: background-color 180ms ease, color 180ms ease, border-color 180ms ease;
  }

  .button-primary {
    border: 1px solid var(--brand, #2b6ca3);
    background: var(--brand, #2b6ca3);
    color: #fff;
  }

  .button-primary:hover {
    border-color: var(--brand-deep, #1f4e78);
    background: var(--brand-deep, #1f4e78);
  }

  .button-secondary,
  .button-quiet {
    border: 1px solid var(--brand-deep, #1f4e78);
    background: #fff;
    color: var(--brand-deep, #1f4e78);
  }

  .button-secondary:hover,
  .button-quiet:hover {
    background: #eef4f8;
  }

  .button-quiet {
    margin-left: auto;
    border-color: transparent;
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  button:focus-visible,
  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible,
  [tabindex]:focus-visible {
    outline: 2px solid var(--brand-deep, #1f4e78);
    outline-offset: 4px;
  }

  .review-list {
    display: grid;
    margin: 1.75rem 0 0;
    border-top: 1px solid var(--line, #c8c9c5);
  }

  .review-list div {
    min-width: 0;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--line, #c8c9c5);
  }

  .review-list dt {
    color: var(--ink-2, #5b6170);
    font-size: 0.72rem;
  }

  .review-list dd {
    margin: 0.25rem 0 0;
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  .confirmation {
    text-align: center;
  }

  .confirmation p {
    max-width: 54ch;
    margin: 1rem auto 0;
    color: var(--ink-2, #5b6170);
  }

  .confirmation button {
    margin-top: 1.5rem;
  }

  .booking-status {
    min-height: 1.4rem;
    margin: 0;
    padding: 0 1.5rem 1rem;
    color: var(--ink-2, #5b6170);
    font-size: 0.75rem;
    text-align: center;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  [hidden] {
    display: none !important;
  }

  @media (min-width: 680px) {
    .booking-intro {
      grid-template-columns: minmax(0, 1.25fr) minmax(16rem, 0.75fr);
      align-items: end;
    }

    .agent-options,
    .field-grid,
    .review-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .field-wide,
    .review-wide {
      grid-column: 1 / -1;
    }

    .review-list div:nth-child(odd):not(.review-wide) {
      padding-right: 1rem;
      border-right: 1px solid var(--line, #c8c9c5);
    }

    .review-list div:nth-child(even) {
      padding-left: 1rem;
    }
  }

  @media (max-width: 479px) {
    .form-actions > * {
      width: 100%;
    }

    .button-quiet {
      margin-left: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      transition: none !important;
      scroll-behavior: auto !important;
    }
  }
</style>
