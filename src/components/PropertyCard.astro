---
import type { PublicListing } from '../domain/public-contract.ts';
import { figurePeriodLabel } from '../domain/catalogue.ts';
import { listingLabel } from '../data/preview.ts';

interface Props { listing: PublicListing; showTour: boolean }

const { listing, showTour } = Astro.props;
const image = listing.media[0];
const primaryFigure = listing.figures[0];
const periodLabel = primaryFigure ? figurePeriodLabel(primaryFigure) : null;
const mediaCanCover = image.width >= 480 && image.height >= 360;
---

<article class="property-card">
  <a href={`/property/${listing.public_id}/`}>
    <div class="card-image">
      <img
        class:list={[mediaCanCover ? 'media--cover' : 'media--intrinsic']}
        style={`--image-width:${image.width}px`}
        src={image.public_path}
        alt={image.alt}
        width={image.width}
        height={image.height}
        loading="lazy"
      />
      <span class="card-status">{listing.status_literal}</span>
    </div>
    <div class="card-content">
      <div class="card-price-row">
        <p class="price">
          {primaryFigure?.display_text ?? 'Price not published'}
          {periodLabel && <small>{periodLabel}</small>}
        </p>
        {(listing.bedrooms !== null || listing.bathrooms !== null) && (
          <p class="card-facts" aria-label="Published property facts">
            {listing.bedrooms !== null && <span>{listing.bedrooms} bed</span>}
            {listing.bathrooms !== null && <span>{listing.bathrooms} bath</span>}
          </p>
        )}
      </div>
      <h2>{listing.title}</h2>
      <p class="muted">{listing.locality ?? 'Location not published'}</p>
      {showTour && <p class="tour-marker">Separate 3D example available</p>}
      <div class="card-footer">
        <p class="demo-label">{listingLabel(listing)}</p>
        <span class="card-link">View property <span aria-hidden="true">&nearr;</span></span>
      </div>
    </div>
  </a>
</article>

<style>
  .tour-marker {
    width: fit-content;
    margin-top: 0.9rem;
    padding: 0.35rem 0.55rem;
    border: 1px solid var(--brand-deep);
    color: var(--brand-deep);
    font-size: 0.72rem;
    font-weight: 700;
  }

  .card-status {
    position: absolute;
    inset: 0.85rem auto auto 0.85rem;
    padding: 0.38rem 0.55rem;
    background: #fff;
    color: var(--brand-deep);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    line-height: 1;
    text-transform: uppercase;
  }
</style>
