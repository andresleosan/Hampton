---
import type { PublicListing } from '../domain/public-contract.ts';
import { figurePeriodLabel } from '../domain/catalogue.ts';
interface Props { listings: PublicListing[] }
const { listings } = Astro.props;

function mediaCanCover(image: PublicListing['media'][number]): boolean {
  return image.width >= 480 && image.height >= 360;
}
---

<section class="commercial-preview" aria-labelledby="commercial-preview-title">
  <header class="section-header">
    <p class="eyebrow">Commercial</p>
    <h2 id="commercial-preview-title">Published commercial examples</h2>
    <p>Verified public snapshots shown for this demo.</p>
    <p class="confidentiality">Confidential locations and descriptions are withheld.</p>
  </header>

  <div class="commercial-grid">
    {listings.map((listing) => {
      const image = listing.media[0];
      const canCover = image ? mediaCanCover(image) : false;
      return (
        <article class="commercial-card">
          {image && (
            <a class="commercial-media-link" href={`/property/${listing.public_id}/`} aria-label={`View ${listing.title}`}>
              <div class:list={['commercial-media', canCover ? 'media-frame--cover' : 'media-frame--intrinsic']}>
                <img
                  class:list={[canCover ? 'media--cover' : 'media--intrinsic']}
                  style={`--image-width:${image.width}px`}
                  src={image.public_path}
                  alt={image.alt}
                  width={image.width}
                  height={image.height}
                  loading="lazy"
                />
                <span class="status">{listing.status_literal}</span>
              </div>
            </a>
          )}

          <div class="card-heading">
            <p class="property-type">Commercial</p>
            <h3><a href={`/property/${listing.public_id}/`}>{listing.title}</a></h3>
            <p class="location">{listing.locality ?? 'Location not published'}</p>
          </div>

          {listing.figures.length > 0 ? <dl class="figure-list">
            {listing.figures.map((figure) => (
              <div class="figure-row">
                <dt>
                  {figure.label_en}
                  {figure.under_review && <span class="review-label">Under review</span>}
                </dt>
                <dd>
                  {figure.display_text}
                  {figurePeriodLabel(figure) && <span class="period"> {figurePeriodLabel(figure)}</span>}
                </dd>
              </div>
            ))}
          </dl> : <p class="figure-missing">Price not published</p>}

          <footer class="snapshot-notes">
            <p>Hampton listing snapshot - checked 4 October 2026.</p>
            <p>Snapshot for this demo - current availability is not verified.</p>
            <div class="snapshot-links">
              <a href={`/property/${listing.public_id}/`}>View local snapshot</a>
              {listing.source && <a href={listing.source.url} rel="external">View source snapshot</a>}
            </div>
          </footer>
        </article>
      );
    })}
  </div>
</section>

<style>
  .commercial-preview {
    color: var(--ink, #323644);
  }

  .section-header {
    max-width: 68ch;
  }

  .eyebrow,
  .status,
  .property-type {
    margin: 0;
    color: var(--brand-deep, #1f4e78);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  h2,
  h3 {
    font-family: var(--font-display, Georgia, 'Times New Roman', serif);
    font-weight: 400;
    line-height: 1.1;
    text-wrap: balance;
  }

  h2 {
    margin: 0.7rem 0 0;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
  }

  .section-header > p:not(.eyebrow) {
    margin: 0.8rem 0 0;
    color: var(--ink-2, #5b6170);
  }

  .confidentiality {
    padding-left: 0.75rem;
    border-left: 3px solid var(--brand-deep, #1f4e78);
    font-weight: 700;
  }

  .commercial-grid {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem) clamp(1.25rem, 3vw, 2rem);
    margin-top: 2.5rem;
  }

  .commercial-card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    background: transparent;
  }

  .commercial-media-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .commercial-media {
    position: relative;
    display: grid;
    aspect-ratio: 4 / 3;
    place-items: center;
    overflow: hidden;
    background: #e9e7e1;
  }

  .commercial-media img {
    transition: transform 220ms ease;
  }

  .commercial-media-link:hover .media--cover {
    transform: scale(1.02);
  }

  .commercial-media .status {
    position: absolute;
    inset: 0.85rem auto auto 0.85rem;
    padding: 0.38rem 0.55rem;
    background: #fff;
  }

  .card-heading,
  .snapshot-notes {
    padding-inline: 0.15rem;
  }

  .card-heading {
    padding-top: 1.15rem;
  }

  h3 {
    margin: 0.65rem 0 0;
    font-size: 1.45rem;
  }

  h3 a {
    color: inherit;
    text-decoration: none;
  }

  h3 a:hover {
    color: var(--brand-deep, #1f4e78);
  }

  .location {
    margin: 0.55rem 0 0;
    color: var(--ink-2, #5b6170);
  }

  .property-type {
    margin-top: 0.8rem;
  }

  .figure-list {
    margin: 1.1rem 0 0;
    border-block: 1px solid var(--line, #c8c9c5);
  }

  .figure-missing {
    margin: 0;
    padding: 1rem 0.15rem;
    border-block: 1px solid var(--line, #c8c9c5);
    color: var(--ink-2, #5b6170);
  }

  .figure-row {
    display: grid;
    gap: 0.35rem;
    padding: 0.9rem 0.15rem;
  }

  .figure-row + .figure-row {
    border-top: 1px solid var(--line, #c8c9c5);
  }

  dt {
    color: var(--ink-2, #5b6170);
    font-size: 0.76rem;
    font-weight: 700;
  }

  dd {
    margin: 0;
    color: var(--brand-deep, #1f4e78);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1.35rem;
  }

  .period {
    color: var(--ink-2, #5b6170);
    font-family: inherit;
    font-size: 0.78rem;
  }

  .review-label {
    display: inline-block;
    margin-left: 0.5rem;
    padding: 0.16rem 0.35rem;
    border: 1px solid currentColor;
    font-size: 0.66rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .snapshot-notes {
    margin-top: auto;
    padding-top: 1rem;
    color: var(--ink-2, #5b6170);
    font-size: 0.75rem;
  }

  .snapshot-notes p {
    margin: 0;
  }

  .snapshot-notes p + p,
  .snapshot-links {
    margin-top: 0.55rem;
  }

  .snapshot-links {
    display: flex;
    gap: 0 1rem;
    flex-wrap: wrap;
  }

  .snapshot-notes a {
    display: inline-block;
    min-height: 44px;
    color: var(--brand, #2b6ca3);
    font-weight: 700;
    line-height: 44px;
    text-underline-offset: 0.2em;
    transition: color 180ms ease;
  }

  .snapshot-notes a:hover {
    color: var(--brand-deep, #1f4e78);
  }

  .snapshot-notes a:focus-visible {
    outline: 2px solid var(--brand-deep, #1f4e78);
    outline-offset: 2px;
  }

  @media (min-width: 700px) {
    .commercial-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .figure-row {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: baseline;
    }
  }

  @media (min-width: 1100px) {
    .commercial-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .snapshot-notes a,
    .commercial-media img {
      transition: none;
    }
  }
</style>
