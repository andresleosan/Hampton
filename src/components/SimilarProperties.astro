---
import { resolveEligibleSimilarListings } from '../domain/similar.ts';
import type { PublicFigure, PublicListing } from '../domain/public-contract.ts';

interface Props {
  listing: PublicListing;
  listings: readonly PublicListing[];
}

const { listing, listings } = Astro.props;

function comparableFigure(candidate: PublicListing): PublicFigure | null {
  const comparableType = candidate.operation === 'sale'
    ? 'sale_price'
    : candidate.operation === 'rent'
      ? 'rent'
      : null;
  if (comparableType === null) return null;

  const figures = candidate.figures.filter(figure => figure.type === comparableType);
  if (figures.length !== 1) return null;
  const figure = figures[0];
  if (
    figure === undefined
    || figure.under_review
    || figure.amount === null
    || figure.currency === null
    || (comparableType === 'rent' && figure.period === null)
  ) return null;
  return figure;
}

const matches = resolveEligibleSimilarListings(listing, listing.similar_ids, listings);

function mediaCanCover(image: PublicListing['media'][number]): boolean {
  return image.width >= 480 && image.height >= 360;
}
---

{matches.length > 0 && (
  <section class="similar-properties" aria-labelledby="similar-properties-title">
    <div class="section-heading">
      <p class="eyebrow">Price comparison</p>
      <h2 id="similar-properties-title">Similar prices</h2>
      <p>Prices are compared within the same property section and sale or rental terms.</p>
    </div>

    <ul class="similar-grid">
      {matches.map(candidate => {
        const image = candidate.media[0];
        const price = comparableFigure(candidate);
        const canCover = image ? mediaCanCover(image) : false;
        const placeholder = image ? image.public_path === '/illustrations/photograph-unavailable.svg' : false;
        return (
          <li>
            <article class="similar-card">
              <a href={`/property/${candidate.public_id}/`}>
                {image && (
                  <div class:list={['card-image', placeholder && 'card-image--placeholder']}>
                    <img
                      class:list={[canCover ? 'media--cover' : 'media--intrinsic']}
                      style={`--image-width:${image.width}px`}
                      src={image.public_path}
                      alt={image.alt}
                      width={image.width}
                      height={image.height}
                      loading="lazy"
                    />
                  </div>
                )}
                <div class="card-copy">
                  <p class="status">{candidate.status_literal}</p>
                  <h3>{candidate.title}</h3>
                  {candidate.locality !== null && <p class="locality">{candidate.locality}</p>}
                  {(candidate.bedrooms !== null || candidate.bathrooms !== null) && (
                    <p class="facts">
                      {candidate.bedrooms !== null && <span>{candidate.bedrooms} bed</span>}
                      {candidate.bathrooms !== null && <span>{candidate.bathrooms} bath</span>}
                    </p>
                  )}
                  <p class="price">{price?.display_text}</p>
                  <span class="view-link">View property <span aria-hidden="true">→</span></span>
                </div>
              </a>
            </article>
          </li>
        );
      })}
    </ul>
  </section>
)}

<style>
  .similar-properties {
    min-width: 0;
    color: var(--ink, #323644);
  }

  .section-heading {
    max-width: 62ch;
    margin-bottom: 1.5rem;
  }

  .eyebrow,
  .status {
    margin: 0;
    color: var(--brand-deep, #1f4e78);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h2,
  h3 {
    font-family: var(--font-display, Georgia, 'Times New Roman', serif);
    font-weight: 400;
    line-height: 1.12;
  }

  h2 {
    margin: 0.65rem 0 0;
    font-size: clamp(1.7rem, 4vw, 2.5rem);
  }

  .section-heading > p:last-child {
    margin: 0.7rem 0 0;
    color: var(--ink-2, #5b6170);
  }

  .similar-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .similar-grid > li,
  .similar-card {
    min-width: 0;
  }

  .similar-card {
    height: 100%;
    background: var(--white, #fff);
  }

  .similar-card > a {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .similar-card > a:focus-visible {
    outline: 2px solid var(--brand-deep, #1f4e78);
    outline-offset: 2px;
  }

  .similar-card > a:hover .media--cover {
    transform: scale(1.02);
  }

  .card-image {
    display: grid;
    place-items: center;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--paper, #f6f4ef);
  }

  .card-image--placeholder {
    min-height: 8rem;
    aspect-ratio: auto;
  }

  .card-image--placeholder img {
    height: 8rem !important;
    object-fit: contain;
  }

  .card-image img {
    transition: transform 220ms ease;
  }

  .card-copy {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
    padding: 1.25rem 0.2rem 0;
  }

  h3 {
    margin: 0.55rem 0 0;
    font-size: clamp(1.3rem, 5vw, 1.65rem);
    overflow-wrap: anywhere;
  }

  .locality,
  .facts,
  .price,
  .view-link {
    margin: 0.55rem 0 0;
  }

  .locality {
    color: var(--ink-2, #5b6170);
  }

  .facts {
    display: flex;
    gap: 0.4rem 1rem;
    flex-wrap: wrap;
    font-size: 0.85rem;
  }

  .price {
    margin-top: auto;
    padding-top: 1.25rem;
    color: var(--brand-deep, #1f4e78);
    font-family: var(--font-display, Georgia, 'Times New Roman', serif);
    font-size: 1.25rem;
  }

  .view-link {
    color: var(--brand-deep, #1f4e78);
    font-size: 0.82rem;
    font-weight: 700;
  }

  @media (min-width: 620px) {
    .similar-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 980px) {
    .similar-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card-image img {
      transition: none;
    }
  }
</style>
