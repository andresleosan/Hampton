---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PropertyCard from '../../components/PropertyCard.astro';
import { loadPreviewData, listingLabel } from '../../data/preview.ts';

const data = await loadPreviewData();
const listings = data.listings.filter(listing => listing.section === 'residential');
const provenance = listings[0] ?? data.listings[0];
const tourListing = data.tour3d ? listings.find(listing => listing.demo.tour3d) : undefined;
const contactListing = listings.find(listing => listing.status_normalised === 'open') ?? listings[0];
const contactHref = contactListing ? `/property/${contactListing.public_id}/#booking` : '/#team';
---

<SiteLayout title="Residential collection" description="Browse dated Jersey residential listing snapshots in the local Hampton Estates demo." current="residential" contactHref={contactHref}>
  <section class="page-heading wrap">
    <p class="eyebrow">The residential collection</p>
    <h1>Find your next chapter.</h1>
    <p class="intro-copy">Jersey property details, presented with room to look closer.</p>
    {provenance && <p class="demo-label">{listingLabel(provenance)}</p>}
    <p class="small muted">Snapshots do not guarantee current availability. All enquiries are simulated.</p>
  </section>

  <section class="catalogue wrap" aria-label="Demo residential properties" data-residential-catalogue>
    {tourListing && (
      <aside class="tour-discovery" aria-label="3D demo location">
        <div>
          <strong>3D example - not this property</strong>
          <span>Available only on the {tourListing.title} demo page.</span>
        </div>
        <a class="button" href={`/property/${tourListing.public_id}/#external-example`}>Open the 3D example</a>
      </aside>
    )}
    <div class="catalogue-filters" role="tablist" aria-label="Residential property sections">
      <button type="button" role="tab" aria-selected="true" data-filter="for-sale">For sale</button>
      <button type="button" role="tab" aria-selected="false" data-filter="to-let">To let</button>
      <button type="button" role="tab" aria-selected="false" data-filter="sold-let">Sold / Let</button>
      <button type="button" role="tab" aria-selected="false" data-filter="international">International</button>
    </div>
    <div class="catalogue-bar">
      <p data-catalogue-count></p>
      <p class="muted">Dated snapshot - local demo preview</p>
    </div>
    <div class="property-grid">
      {listings.map(listing => (
        <div data-residential-card data-tab={listing.tab} hidden={listing.tab !== 'for-sale'}>
          <PropertyCard listing={listing} showTour={Boolean(data.tour3d && listing.demo.tour3d)} />
        </div>
      ))}
    </div>
    <p class="catalogue-empty" data-catalogue-empty hidden>No properties to show in this section.</p>
  </section>
</SiteLayout>

<script>
  document.querySelectorAll<HTMLElement>('[data-residential-catalogue]').forEach((catalogue) => {
    const buttons = [...catalogue.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const cards = [...catalogue.querySelectorAll<HTMLElement>('[data-residential-card]')];
    const count = catalogue.querySelector<HTMLElement>('[data-catalogue-count]');
    const empty = catalogue.querySelector<HTMLElement>('[data-catalogue-empty]');
    const select = (tab: string) => {
      let visible = 0;
      for (const card of cards) {
        card.hidden = card.dataset.tab !== tab;
        if (!card.hidden) visible += 1;
      }
      for (const button of buttons) button.setAttribute('aria-selected', String(button.dataset.filter === tab));
      if (count) count.textContent = `${visible} ${visible === 1 ? 'property' : 'properties'}`;
      if (empty) empty.hidden = visible !== 0;
    };
    for (const button of buttons) button.addEventListener('click', () => select(button.dataset.filter ?? 'for-sale'));
    select('for-sale');
  });
</script>

<style>
  .tour-discovery {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
    padding: 1rem;
    border-left: 3px solid var(--brand-deep);
    background: #fff;
  }

  .tour-discovery div {
    display: grid;
    gap: 0.25rem;
  }

  .tour-discovery span {
    color: var(--ink-2);
    font-size: 0.85rem;
  }

  .catalogue-filters {
    display: flex;
    gap: 0 1.5rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--line);
  }

  .catalogue-filters button {
    min-height: 44px;
    padding: 0.65rem 0;
    border: 0;
    border-bottom: 3px solid transparent;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    font: inherit;
    font-weight: 700;
  }

  .catalogue-filters button[aria-selected="true"] {
    border-bottom-color: var(--brand-deep);
    background: transparent;
    color: var(--brand-deep);
  }

  .catalogue-filters button:focus-visible {
    outline: 2px solid var(--brand-deep);
    outline-offset: 2px;
  }

  [data-residential-card] {
    min-width: 0;
  }

  .catalogue-empty {
    padding: 2rem;
    border: 1px solid var(--line);
    background: #fff;
  }
</style>
