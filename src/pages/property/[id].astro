---
import AerialDemo from '../../components/AerialDemo.astro';
import BookingFlow from '../../components/BookingFlow.astro';
import MortgageCalculator from '../../components/MortgageCalculator.astro';
import SimilarProperties from '../../components/SimilarProperties.astro';
import TeamSection from '../../components/TeamSection.astro';
import Tour3D from '../../components/Tour3D.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { loadPreviewData, listingLabel, photographLabel } from '../../data/preview.ts';
import { figurePeriodLabel } from '../../domain/catalogue.ts';
import type { PublicAgent, PublicListing, PublicTour3D } from '../../domain/public-contract.ts';

export async function getStaticPaths() {
  const data = await loadPreviewData();
  return data.listings.map(listing => ({
    params: { id: listing.public_id },
    props: { listing, listings: data.listings, agents: data.agents, tour3d: data.tour3d },
  }));
}

interface Props {
  listing: PublicListing;
  listings: PublicListing[];
  agents: PublicAgent[];
  tour3d: PublicTour3D | null;
}

const { listing, listings, agents, tour3d } = Astro.props;
const image = listing.media[0];
const additionalMedia = listing.media.slice(1);
const primaryFigure = listing.figures[0];
const propertyCanCover = image.width >= 1280 && image.height >= 800 && image.width / image.height >= 1.25;
const showTour = listing.demo.tour3d && tour3d;
const backHref = listing.section === 'commercial' ? '/commercial/' : '/residential/';
const backLabel = listing.section === 'commercial' ? 'commercial' : 'residential';
const provenanceLabel = listing.source
  ? 'Real listing snapshot - published property details'
  : 'Synthetic fallback - fictional property details';
const hasPublishedFacts = listing.bedrooms !== null || listing.bathrooms !== null;
---

<SiteLayout title={listing.title} description={`${listing.title} - ${listingLabel(listing)}.`} contactHref="#booking">
  <div class="wrap"><a class="back-link" href={backHref}>&larr; Back to {backLabel}</a></div>

  <section class="property-hero wrap" aria-labelledby="property-title">
    <div class="property-gallery" data-property-gallery data-gallery-items={JSON.stringify(listing.media)}>
      <div
        class:list={['property-art', propertyCanCover ? 'property-art--cover' : 'property-art--intrinsic']}
        style={`--property-media-width:${image.width}px`}
      >
        <button class="property-photo-frame" type="button" data-gallery-open data-gallery-index="0" aria-label={`Open photograph 1 of ${listing.media.length}`}>
          <img
            class:list={[propertyCanCover ? 'media--cover' : 'media--intrinsic']}
            style={`--image-width:${image.width}px`}
            src={image.public_path}
            alt={image.alt}
            width={image.width}
            height={image.height}
            fetchpriority="high"
          />
        </button>
      </div>
      {additionalMedia.length > 0 && (
        <div class="property-thumbnails" aria-label="Additional property photographs">
          {listing.media.slice(1).map((media, index) => (
            <button type="button" data-gallery-open data-gallery-index={index + 1} aria-label={`Open photograph ${index + 2} of ${listing.media.length}`}>
              <img
                class="media--intrinsic"
                style={`--image-width:${media.width}px`}
                src={media.public_path}
                alt=""
                width={media.width}
                height={media.height}
                loading="lazy"
              />
            </button>
          ))}
        </div>
      )}
      <p class="property-photo-caption">{photographLabel(listing)}</p>

      <dialog class="property-lightbox" aria-label="Property photographs" data-gallery-dialog>
        <div class="lightbox-bar">
          <p data-gallery-counter></p>
          <button type="button" data-gallery-close>Close</button>
        </div>
        <div class="lightbox-frame"><img data-gallery-image src={image.public_path} alt={image.alt} /></div>
        {listing.media.length > 1 && (
          <div class="lightbox-controls">
            <button type="button" data-gallery-previous>&larr; Previous</button>
            <button type="button" data-gallery-next>Next &rarr;</button>
          </div>
        )}
      </dialog>
    </div>

    <aside class="property-summary ledger" aria-label="Property summary and demo viewing">
      <p class="eyebrow">{listing.status_literal}</p>
      <h1 id="property-title">{listing.title}</h1>
      <p class="property-location">{listing.locality ?? 'Location not published'}</p>
      {primaryFigure && (
        <p class="property-price">
          <span>{primaryFigure.label_en}</span>
          {primaryFigure.display_text}
          {figurePeriodLabel(primaryFigure) && <small>{figurePeriodLabel(primaryFigure)}</small>}
        </p>
      )}
      {hasPublishedFacts && (
        <dl class="property-facts" aria-label="Published property facts">
          {listing.bedrooms !== null && <div><dt>Bedrooms</dt><dd>{listing.bedrooms}</dd></div>}
          {listing.bathrooms !== null && <div><dt>Bathrooms</dt><dd>{listing.bathrooms}</dd></div>}
        </dl>
      )}
      <p class="demo-label">{listingLabel(listing)}</p>
      <nav class="property-jump" aria-label="Property demo sections">
        <a href="#illustrative-tools">Illustrative tools</a>
        {showTour && <a href="#external-example">3D example</a>}
        <a href="#booking">Booking demo</a>
      </nav>
      <a class="button" href="#booking">Request a viewing (demo)</a>
      <p class="small">Nothing is sent or saved. No viewing is booked.</p>
    </aside>
  </section>

  <div class="property-body wrap">
    <section class="about-home" aria-labelledby="about-title">
      <p class="eyebrow">{provenanceLabel}</p>
      <h2 id="about-title">A closer look.</h2>
      <p>{listing.description_public ?? 'Description not published.'}</p>
      {listing.section === 'commercial' && listing.figures.length > 0 && (
        <dl class="key-facts commercial-figures" aria-label="Published commercial figures">
          {listing.figures.map(figure => (
            <div>
              <dt>{figure.label_en}</dt>
              <dd>
                {figure.display_text}
                {figurePeriodLabel(figure) && <span> {figurePeriodLabel(figure)}</span>}
                {figure.under_review && <small> Under review</small>}
              </dd>
            </div>
          ))}
        </dl>
      )}
      {listing.source && (
        <p class="small">
          <a class="source-link" href={listing.source.url} rel="external">Official listing source</a>
          {' '}- checked 4 October 2026. This snapshot does not guarantee current availability.
        </p>
      )}
    </section>
  </div>

  <div class="property-experience wrap">
    <section id="illustrative-tools" class="experience-section" aria-labelledby="illustrative-tools-title">
      <header class="experience-heading experience-heading--compact">
        <p class="eyebrow">Illustrative property tools</p>
        <h2 id="illustrative-tools-title">Explore before you enquire.</h2>
        <p>
          A clearly labelled land concept and, where eligible, a local repayment estimate.
        </p>
      </header>
      <div class="experience-stack">
        <AerialDemo />
        <MortgageCalculator calculator={listing.calculator} />
      </div>
    </section>

    {listing.similar_ids.length > 0 && (
      <section class="experience-section" aria-label="Related listing snapshots">
        <p class="experience-boundary">{provenanceLabel}</p>
        <SimilarProperties listing={listing} listings={listings} />
      </section>
    )}

    {showTour && (
      <section id="external-example" class="experience-section" aria-labelledby="external-example-title">
        <header class="experience-heading">
          <p class="eyebrow">External example</p>
          <h2 id="external-example-title">A clearly separate 3D demonstration.</h2>
          <p>The third-party model is credited in the viewer and does not depict this listing.</p>
        </header>
        <Tour3D tour={tour3d} />
      </section>
    )}

    <section id="booking" class="experience-section" aria-label="Simulated viewing booking">
      <BookingFlow agents={agents} />
    </section>

    <section class="experience-section experience-section--team" aria-label="Published Hampton team snapshot">
      <TeamSection agents={agents} />
    </section>

    {listing.legal_notice && (
      <aside class="legal-note" aria-labelledby="legal-note-title">
        <p class="eyebrow">Published legal notice</p>
        <h2 id="legal-note-title">Important information.</h2>
        <p>{listing.legal_notice.disclaimer}</p>
        <p>{listing.legal_notice.aml}</p>
      </aside>
    )}
  </div>
</SiteLayout>

<script>
  interface GalleryItem { public_path: string; alt: string }

  document.querySelectorAll<HTMLElement>('[data-property-gallery]').forEach(root => {
    const dialog = root.querySelector<HTMLDialogElement>('[data-gallery-dialog]');
    const image = root.querySelector<HTMLImageElement>('[data-gallery-image]');
    const counter = root.querySelector<HTMLElement>('[data-gallery-counter]');
    if (!dialog || !image || !counter) return;

    const items = JSON.parse(root.dataset.galleryItems ?? '[]') as GalleryItem[];
    let current = 0;

    const render = () => {
      const item = items[current];
      if (!item) return;
      image.src = item.public_path;
      image.alt = item.alt;
      counter.textContent = `Photograph ${current + 1} of ${items.length}`;
    };

    const move = (amount: number) => {
      current = (current + amount + items.length) % items.length;
      render();
    };

    root.querySelectorAll<HTMLButtonElement>('[data-gallery-open]').forEach(button => {
      button.addEventListener('click', () => {
        current = Number(button.dataset.galleryIndex ?? 0);
        render();
        dialog.showModal();
      });
    });
    root.querySelector<HTMLButtonElement>('[data-gallery-close]')?.addEventListener('click', () => dialog.close());
    root.querySelector<HTMLButtonElement>('[data-gallery-previous]')?.addEventListener('click', () => move(-1));
    root.querySelector<HTMLButtonElement>('[data-gallery-next]')?.addEventListener('click', () => move(1));
    dialog.addEventListener('click', event => {
      if (event.target === dialog) dialog.close();
    });
  });
</script>
